# ─────────────────────────────────────────────────────────────
# Payment Service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5434
DB_NAME=payment_db
DB_USER=postgres
DB_PASSWORD=changeme

# ── Spring ────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker

# ── Downstream Services ───────────────────────────────────────
ORDER_SERVICE_URL=http://order-service:8082

# ── AWS (used by GitHub Actions for ECS deploy) ───────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=ecommerce/payment-service
ECS_CLUSTER=ecommerce-cluster
ECS_SERVICE=payment-service
ECS_TASK_DEFINITION=payment-service-task
