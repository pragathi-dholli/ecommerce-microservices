# ─────────────────────────────────────────────────────────────
# Product Service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=product_db
DB_USER=postgres
DB_PASSWORD=changeme

# ── Spring ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker   # local | docker | prod

# ── AWS (needed by GitHub Actions for ECS deploy) ────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=ecommerce/product-service
ECS_CLUSTER=ecommerce-cluster
ECS_SERVICE=product-service
ECS_TASK_DEFINITION=product-service-task
