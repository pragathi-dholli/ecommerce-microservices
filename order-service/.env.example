# ─────────────────────────────────────────────────────────────
# Order Service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=order_db
DB_USER=postgres
DB_PASSWORD=changeme

# ── Spring ────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker

# ── Downstream Services ───────────────────────────────────────
PRODUCT_SERVICE_URL=http://product-service:8081
PAYMENT_SERVICE_URL=http://payment-service:8083

# ── AWS (used by GitHub Actions for ECS deploy) ───────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=ecommerce/order-service
ECS_CLUSTER=ecommerce-cluster
ECS_SERVICE=order-service
ECS_TASK_DEFINITION=order-service-task
